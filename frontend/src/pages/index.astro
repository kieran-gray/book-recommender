---
export const prerender = true;

import { siteConfig } from '@/config/site';
import BaseLayout from '@/layouts/BaseLayout.astro';

const title = siteConfig.meta.title;
const description = siteConfig.meta.description;
const endpoint = '/api/recommend';
---

<BaseLayout head={{ title, description }}>
	<main class="book-page">
		<section class="book-shell">
			<div class="book-copy">
				<h1>Find the book that fits best.</h1>
				<p class="book-intro">
					Turn a Goodreads export into the best pick from the books already waiting on the shelf.
				</p>
			</div>

			<section id="book-recommender" data-endpoint={endpoint} class="book-app" aria-live="polite">
				<div class="book-visual" aria-hidden="true">
					<span class="cover cover-a"></span>
					<span class="cover cover-b"></span>
					<span class="cover cover-c"></span>
					<span class="shelf-line"></span>
				</div>

				<ol class="book-progress" aria-label="Progress">
					<li class="book-progress-step" data-for="upload"><span>1 · Upload</span></li>
					<li class="book-progress-step" data-for="questions"><span>2 · Questions</span></li>
					<li class="book-progress-step" data-for="recommendation"><span>3 · Pick</span></li>
				</ol>

				<div class="book-panel upload-panel" data-step="upload">
					<div class="book-panel-header">
						<div>
							<p class="book-kicker">Library</p>
							<h2 id="source-heading">Pick a source</h2>
						</div>
					</div>

					<div class="source-tabs" role="tablist" aria-label="Library source">
						<button
							type="button"
							class="source-tab"
							data-source="csv"
							role="tab"
							aria-selected="true"
						>
							Goodreads CSV
						</button>
						<button
							type="button"
							class="source-tab"
							data-source="fable"
							role="tab"
							aria-selected="false"
						>
							Fable profile
						</button>
					</div>

					<div class="source-panel" data-source-panel="csv">
						<label class="book-drop">
							<input id="goodreads-csv" type="file" accept=".csv,text/csv" />
							<span class="drop-icon" aria-hidden="true">+</span>
							<span class="drop-text">
								<span class="drop-title">Choose CSV</span>
								<small>Unread books only</small>
							</span>
						</label>
					</div>

					<div class="source-panel" data-source-panel="fable" hidden>
						<form id="fable-form" class="fable-form">
							<label for="fable-url" class="fable-label">
								<span class="drop-title">Fable profile URL</span>
								<small>e.g. https://fable.co/fabler/your-username</small>
							</label>
							<div class="fable-input-row">
								<input
									id="fable-url"
									name="fable-url"
									type="url"
									inputmode="url"
									autocomplete="off"
									spellcheck="false"
									placeholder="https://fable.co/fabler/..."
									required
								/>
								<button type="submit" class="primary">
									<span>Load lists</span>
									<span class="spinner" aria-hidden="true"></span>
								</button>
							</div>
						</form>

						<div id="fable-lists" class="fable-lists" hidden>
							<p class="book-kicker">Choose a list</p>
							<ul id="fable-list-options" class="fable-list-options"></ul>
						</div>
					</div>

					<div id="library-summary" class="book-summary" hidden></div>
				</div>

				<form id="question-form" class="book-panel question-panel" data-step="questions" hidden>
					<div class="book-panel-header">
						<div>
							<p class="book-kicker">Mood check</p>
							<h2 id="question-title">Answer this</h2>
						</div>
						<span id="question-progress" class="book-pill" aria-live="polite">1</span>
					</div>
					<label for="answer-input" id="question-label" class="book-question"></label>
					<textarea
						id="answer-input"
						rows="4"
						maxlength="600"
						placeholder="What sounds right today?"
						autocapitalize="sentences"
						autocomplete="off"
						spellcheck="true"
						enterkeyhint="send"
					></textarea>
					<div class="book-actions">
						<button id="submit-answer" type="submit" class="primary">
							<span>Answer</span>
							<span class="spinner" aria-hidden="true"></span>
						</button>
						<button id="skip-question" type="button" class="secondary">Skip</button>
					</div>
				</form>

				<div id="recommendation-panel" class="book-panel recommendation-panel" data-step="recommendation" hidden>
					<div class="book-panel-header">
						<div>
							<p class="book-kicker">Next read</p>
							<h2>Start here</h2>
						</div>
						<span id="recommendation-progress" class="book-pill">1 of 3</span>
					</div>
					<h3 id="recommendation-title"></h3>
					<p id="recommendation-author" class="book-author"></p>
					<p id="recommendation-reason" class="book-reason"></p>
					<div class="recommendation-actions">
						<button id="next-recommendation" type="button" class="primary">Try another</button>
						<button id="start-over" type="button" class="secondary">Pick another</button>
					</div>
				</div>

				<p id="book-status" class="book-status" role="status"></p>
			</section>
		</section>
	</main>

	<style>
		:global(body) {
			background: #f6efe0;
			color: #1d2730;
		}

		.book-page {
			--ink: #1d2730;
			--paper: #fffaf0;
			--paper-deep: #f4dfb7;
			--rose: #c75b57;
			--teal: #227c7a;
			--blue: #3d5a80;
			--shadow: 0 24px 70px rgba(29, 39, 48, 0.18);
			width: 100%;
			padding: clamp(1rem, 4vw, 3rem);
			padding-bottom: calc(clamp(1rem, 4vw, 3rem) + env(safe-area-inset-bottom, 0px));
			color: var(--ink);
		}

		.book-shell {
			position: relative;
			display: grid;
			grid-template-columns: minmax(0, 0.92fr) minmax(320px, 1.08fr);
			gap: clamp(1.5rem, 5vw, 4rem);
			align-items: center;
			width: min(1180px, 100%);
			min-height: calc(100vh - 9rem);
			margin: 0 auto;
		}

		.book-copy {
			display: grid;
			gap: 1.1rem;
			align-content: center;
		}

		.book-eyebrow,
		.book-kicker {
			margin: 0;
			font-size: 0.74rem;
			font-weight: 800;
			letter-spacing: 0.02em;
			text-transform: uppercase;
			color: var(--teal);
		}

		.book-copy h1 {
			margin: 0;
			font-size: clamp(2.25rem, 8vw, 6.9rem);
			font-weight: 900;
			line-height: 1;
			letter-spacing: -0.01em;
			text-wrap: balance;
		}

		.book-intro {
			max-width: 34rem;
			margin: 0;
			font-size: clamp(0.95rem, 1.5vw, 1.18rem);
			line-height: 1.65;
			color: color-mix(in srgb, var(--ink) 74%, white);
		}

		.book-stats {
			display: flex;
			flex-wrap: wrap;
			gap: 0.5rem;
			margin-top: 0.15rem;
		}

		.book-stats span {
			border: 1px solid rgba(29, 39, 48, 0.16);
			border-radius: 999px;
			background: rgba(255, 250, 240, 0.74);
			padding: 0.4rem 0.7rem;
			font-size: 0.74rem;
			font-weight: 800;
			box-shadow: 0 6px 18px rgba(29, 39, 48, 0.06);
		}

		.book-app {
			position: relative;
			display: grid;
			gap: 0.85rem;
			border: 1px solid rgba(29, 39, 48, 0.14);
			border-radius: 14px;
			background: var(--paper);
			padding: clamp(0.85rem, 2.2vw, 1.45rem);
			box-shadow: var(--shadow);
			overflow: hidden;
			isolation: isolate;
		}

		.book-visual {
			position: relative;
			height: clamp(5.25rem, 14vw, 10rem);
			margin-bottom: 0.1rem;
		}

		.cover {
			position: absolute;
			bottom: 1.15rem;
			width: clamp(3.25rem, 10vw, 5.8rem);
			border-radius: 5px 8px 8px 5px;
			box-shadow: 0 14px 28px rgba(29, 39, 48, 0.16);
			transform-origin: bottom center;
		}

		.cover::after {
			content: '';
			position: absolute;
			inset: 0.6rem auto 0.6rem 0.55rem;
			width: 3px;
			border-radius: 999px;
			background: rgba(255, 255, 255, 0.46);
		}

		.cover-a {
			left: 8%;
			height: 82%;
			background: var(--rose);
			transform: rotate(-8deg);
		}

		.cover-b {
			left: 29%;
			height: 94%;
			background: var(--teal);
			transform: rotate(3deg);
		}

		.cover-c {
			left: 51%;
			height: 76%;
			background: var(--blue);
			transform: rotate(9deg);
		}

		.shelf-line {
			position: absolute;
			right: 5%;
			bottom: 0.65rem;
			left: 3%;
			height: 0.6rem;
			border-radius: 999px;
			background: #b07a4a;
			box-shadow: 0 11px 24px rgba(91, 63, 42, 0.2);
		}

		.book-progress {
			display: grid;
			grid-template-columns: repeat(3, 1fr);
			gap: 0.35rem;
			padding: 0;
			margin: 0;
			list-style: none;
		}

		.book-progress-step {
			position: relative;
			display: flex;
			align-items: center;
			justify-content: center;
			min-height: 1.85rem;
			padding: 0 0.35rem;
			border-radius: 999px;
			background: rgba(29, 39, 48, 0.06);
			font-size: 0.7rem;
			font-weight: 900;
			letter-spacing: 0.01em;
			color: color-mix(in srgb, var(--ink) 50%, white);
			transition: background 200ms ease, color 200ms ease, box-shadow 200ms ease;
		}

		.book-progress-step span {
			white-space: nowrap;
			overflow: hidden;
			text-overflow: ellipsis;
		}

		#book-recommender:has([data-step='upload']:not([hidden])) .book-progress-step[data-for='upload'],
		#book-recommender:has([data-step='questions']:not([hidden])) .book-progress-step[data-for='questions'],
		#book-recommender:has([data-step='recommendation']:not([hidden])) .book-progress-step[data-for='recommendation'] {
			background: var(--ink);
			color: #fffaf0;
			box-shadow: 0 6px 18px rgba(29, 39, 48, 0.22);
		}

		#book-recommender:has([data-step='questions']:not([hidden])) .book-progress-step[data-for='upload'],
		#book-recommender:has([data-step='recommendation']:not([hidden])) .book-progress-step[data-for='upload'],
		#book-recommender:has([data-step='recommendation']:not([hidden])) .book-progress-step[data-for='questions'] {
			background: rgba(34, 124, 122, 0.18);
			color: var(--teal);
		}

		.book-panel {
			position: relative;
			border: 1px solid rgba(29, 39, 48, 0.12);
			border-radius: 12px;
			background: #ffffffc7;
			padding: clamp(0.95rem, 2.2vw, 1.25rem);
			box-shadow: 0 12px 28px rgba(29, 39, 48, 0.07);
			animation: panel-in 280ms ease both;
		}

		.book-panel[hidden] {
			display: none;
		}

		.book-panel-header {
			display: flex;
			align-items: flex-start;
			justify-content: space-between;
			gap: 1rem;
			margin-bottom: 0.8rem;
		}

		.book-panel h2,
		.book-panel h3 {
			margin: 0.1rem 0 0;
			font-size: 1.2rem;
			font-weight: 900;
			line-height: 1.2;
		}

		.book-pill {
			flex: 0 0 auto;
			border: 1px solid rgba(29, 39, 48, 0.13);
			border-radius: 999px;
			background: #ffffff;
			padding: 0.34rem 0.62rem;
			font-size: 0.72rem;
			font-weight: 900;
			color: color-mix(in srgb, var(--ink) 72%, white);
			white-space: nowrap;
		}

		.source-tabs {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 0.35rem;
			margin-bottom: 0.85rem;
			padding: 0.25rem;
			border-radius: 999px;
			background: rgba(29, 39, 48, 0.06);
		}

		.source-tab {
			min-height: 2.2rem;
			border: 0;
			border-radius: 999px;
			background: transparent;
			padding: 0 0.85rem;
			font: inherit;
			font-size: 0.78rem;
			font-weight: 900;
			letter-spacing: 0.01em;
			color: color-mix(in srgb, var(--ink) 60%, white);
			box-shadow: none;
			cursor: pointer;
			transition: background 160ms ease, color 160ms ease;
		}

		.source-tab[aria-selected='true'] {
			background: var(--ink);
			color: #fffaf0;
			box-shadow: 0 6px 16px rgba(29, 39, 48, 0.18);
		}

		.source-tab:hover:not([aria-selected='true']) {
			color: var(--ink);
			background: rgba(29, 39, 48, 0.08);
			transform: none;
			box-shadow: none;
		}

		.source-panel[hidden] {
			display: none;
		}

		.fable-form {
			display: grid;
			gap: 0.6rem;
		}

		.fable-label {
			display: grid;
			gap: 0.15rem;
		}

		.fable-label small {
			color: color-mix(in srgb, var(--ink) 62%, white);
		}

		.fable-input-row {
			display: grid;
			gap: 0.55rem;
		}

		@media (min-width: 480px) {
			.fable-input-row {
				grid-template-columns: 1fr auto;
				align-items: stretch;
			}
		}

		#fable-url {
			width: 100%;
			min-height: 2.85rem;
			border: 1px solid rgba(29, 39, 48, 0.15);
			border-radius: 10px;
			background: rgba(255, 250, 240, 0.88);
			padding: 0 0.85rem;
			font: inherit;
			font-size: 16px;
			color: var(--ink);
			box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.7);
		}

		#fable-url:focus {
			border-color: var(--teal);
			outline: 3px solid rgba(34, 124, 122, 0.18);
		}

		.fable-lists {
			margin-top: 1.1rem;
			display: grid;
			gap: 0.65rem;
		}

		.fable-lists :global(.book-kicker) {
			margin: 0;
		}

		.fable-list-options {
			list-style: none;
			padding: 0;
			margin: 0;
			display: grid;
			gap: 0.55rem;
		}

		:global(.fable-list-option) {
			position: relative;
			display: grid;
			grid-template-columns: 1fr auto;
			column-gap: 1rem;
			row-gap: 0.15rem;
			align-items: center;
			width: 100%;
			min-height: 3.4rem;
			border: 1px solid rgba(29, 39, 48, 0.12);
			border-radius: 12px;
			background: #ffffff;
			padding: 0.75rem 2.1rem 0.75rem 1rem;
			font: inherit;
			color: #1d2730;
			box-shadow: 0 6px 14px rgba(29, 39, 48, 0.05);
			cursor: pointer;
			text-align: left;
			transition:
				border-color 160ms ease,
				background 160ms ease,
				transform 160ms ease,
				box-shadow 160ms ease;
		}

		:global(.fable-list-option::after) {
			content: '';
			position: absolute;
			top: 50%;
			right: 0.95rem;
			width: 0.55rem;
			height: 0.55rem;
			border-top: 2px solid color-mix(in srgb, #1d2730 45%, white);
			border-right: 2px solid color-mix(in srgb, #1d2730 45%, white);
			transform: translateY(-50%) rotate(45deg);
			transition: border-color 160ms ease, right 160ms ease;
		}

		:global(.fable-list-option:hover) {
			border-color: #227c7a;
			background: rgba(34, 124, 122, 0.06);
			transform: translateY(-1px);
			box-shadow: 0 10px 22px rgba(29, 39, 48, 0.09);
		}

		:global(.fable-list-option:hover::after) {
			border-top-color: #227c7a;
			border-right-color: #227c7a;
			right: 0.75rem;
		}

		:global(.fable-list-option:focus-visible) {
			outline: 3px solid rgba(34, 124, 122, 0.28);
			outline-offset: 2px;
		}

		:global(.fable-list-option .list-name) {
			display: block;
			font-size: 0.98rem;
			font-weight: 900;
			line-height: 1.25;
			text-wrap: balance;
		}

		:global(.fable-list-option .list-count) {
			justify-self: end;
			border-radius: 999px;
			background: rgba(29, 39, 48, 0.07);
			padding: 0.25rem 0.65rem;
			font-size: 0.72rem;
			font-weight: 800;
			letter-spacing: 0.01em;
			color: color-mix(in srgb, #1d2730 65%, white);
			white-space: nowrap;
		}

		:global(.fable-list-option:hover .list-count) {
			background: rgba(34, 124, 122, 0.14);
			color: #227c7a;
		}

		.book-drop {
			position: relative;
			display: grid;
			grid-template-columns: auto 1fr;
			gap: 0.85rem;
			align-items: center;
			border: 1.5px dashed rgba(34, 124, 122, 0.54);
			border-radius: 10px;
			background: rgba(34, 124, 122, 0.08);
			padding: 1rem;
			min-height: 4.5rem;
			cursor: pointer;
			transition:
				transform 160ms ease,
				border-color 160ms ease,
				background 160ms ease;
		}

		.book-drop:hover,
		.book-drop:focus-within {
			border-color: var(--teal);
			background: rgba(34, 124, 122, 0.14);
			transform: translateY(-1px);
		}

		.book-drop:active {
			transform: translateY(0);
		}

		.book-drop input {
			position: absolute;
			width: 1px;
			height: 1px;
			overflow: hidden;
			clip: rect(0 0 0 0);
			white-space: nowrap;
		}

		.drop-icon {
			display: grid;
			place-items: center;
			width: 2.7rem;
			height: 2.7rem;
			border-radius: 10px;
			background: var(--ink);
			color: #fffaf0;
			font-size: 1.55rem;
			font-weight: 900;
			line-height: 1;
		}

		.drop-text {
			display: grid;
			gap: 0.15rem;
		}

		.drop-title {
			font-weight: 900;
			color: var(--ink);
		}

		.book-drop small {
			color: color-mix(in srgb, var(--ink) 62%, white);
		}

		.book-summary,
		.book-status,
		.book-author,
		.book-reason {
			color: color-mix(in srgb, var(--ink) 68%, white);
		}

		.book-summary {
			margin-top: 0.85rem;
			border-left: 4px solid var(--teal);
			padding: 0.15rem 0 0.15rem 0.8rem;
			line-height: 1.55;
			font-size: 0.9rem;
			font-weight: 700;
		}

		.book-question {
			display: block;
			font-weight: 700;
			color: var(--ink);
			font-size: clamp(1rem, 1.35vw, 1.18rem);
			line-height: 1.55;
		}

		textarea {
			margin-top: 0.85rem;
			width: 100%;
			min-height: 7.5rem;
			resize: vertical;
			border: 1px solid rgba(29, 39, 48, 0.15);
			border-radius: 10px;
			background: rgba(255, 250, 240, 0.88);
			padding: 0.85rem;
			color: var(--ink);
			font: inherit;
			font-size: 16px;
			line-height: 1.55;
			box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.7);
		}

		textarea:focus {
			border-color: var(--teal);
			outline: 3px solid rgba(34, 124, 122, 0.18);
		}

		.book-actions {
			display: grid;
			gap: 0.6rem;
			margin-top: 0.9rem;
		}

		@media (min-width: 480px) {
			.book-actions {
				grid-template-columns: 1fr auto;
			}
		}

		button {
			position: relative;
			display: inline-flex;
			align-items: center;
			justify-content: center;
			gap: 0.5rem;
			min-height: 2.85rem;
			border: 0;
			border-radius: 10px;
			background: var(--ink);
			padding: 0 1.1rem;
			font: inherit;
			font-weight: 900;
			color: #fffaf0;
			box-shadow: 0 10px 22px rgba(29, 39, 48, 0.18);
			cursor: pointer;
			transition:
				transform 160ms ease,
				box-shadow 160ms ease,
				opacity 160ms ease;
		}

		button:hover {
			box-shadow: 0 14px 26px rgba(29, 39, 48, 0.22);
			transform: translateY(-1px);
		}

		button:active {
			transform: translateY(0);
		}

		button.secondary {
			border: 1px solid rgba(29, 39, 48, 0.16);
			background: rgba(255, 255, 255, 0.78);
			color: var(--ink);
			box-shadow: none;
		}

		button.full-width {
			width: 100%;
			margin-top: 0.8rem;
		}

		button:disabled {
			cursor: wait;
			opacity: 0.65;
			transform: none;
		}

		.spinner {
			display: none;
			width: 0.95rem;
			height: 0.95rem;
			border-radius: 50%;
			border: 2px solid currentColor;
			border-right-color: transparent;
		}

		#book-recommender[data-state='busy'] .primary .spinner {
			display: inline-block;
			animation: spin 720ms linear infinite;
		}

		#book-recommender[data-state='busy'] .primary > span:first-child {
